# =====================================
# Python & Django .gitignore (Standard)
# =====================================

# Environment variables and secrets
.env
.env.*
!.env.example

# Virtual Environments
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Django local database & logs
*.log
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Django media & static collection
media/
staticfiles/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checker caches
.mypy_cache/
.pytype/
.pyre/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini