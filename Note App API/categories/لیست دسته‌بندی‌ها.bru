meta {
  name: لیست دسته‌بندی‌ها
  type: http
  seq: 1
  tags: [
    categories
  ]
}

get {
  url: {{baseUrl}}/api/categories/list
  body: none
  auth: apikey
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  دریافت تمامی دسته‌بندی‌های عمومی یادداشت‌ها.
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/categories/list
    method: GET
    mode: none
    headers: {
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "meta": {
            "message": "Operation successful",
            "errors": {}
          },
          "data": [
            {
              "id": 0,
              "name": ""
            }
          ]
        }
      '''
    }
  }
}
