meta {
  name: ایجاد یادداشت جدید
  type: http
  seq: 1
  tags: [
    notes
  ]
}

post {
  url: {{baseUrl}}/api/notes/create
  body: json
  auth: apikey
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "title": "",
    "content": "",
    "category": 0
  }
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  یک یادداشت جدید می‌سازد و در صورت احراز هویت، آن را به کاربر متصل می‌کند.
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/notes/create
    method: POST
    mode: json
    headers: {
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "title": "",
        "content": "",
        "category": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "meta": {
            "message": "Operation successful",
            "errors": {}
          },
          "data": {
            "id": 0,
            "title": "",
            "content": "",
            "created_at": "",
            "updated_at": "",
            "category": ""
          }
        }
      '''
    }
  }
}
