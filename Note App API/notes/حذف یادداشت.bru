meta {
  name: حذف یادداشت
  type: http
  seq: 2
  tags: [
    notes
  ]
}

delete {
  url: {{baseUrl}}/api/notes/delete/:id
  body: none
  auth: apikey
}

params:path {
  id: 
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  حذف یادداشت بر اساس شناسه.
}

example {
  name: 200 Response
  description: No response body
  
  request: {
    url: {{baseUrl}}/api/notes/delete/:id
    method: DELETE
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
