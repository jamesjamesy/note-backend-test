meta {
  name: notes_create
  type: http
  seq: 2
  tags: [
    notes
  ]
}

post {
  url: {{baseUrl}}/api/notes/
  body: json
  auth: apikey
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "title": "",
    "content": "",
    "category": 0
  }
}

settings {
  forwardAuthorizationHeader: false
}

example {
  name: 201 Response
  
  request: {
    url: {{baseUrl}}/api/notes/
    method: POST
    mode: json
    headers: {
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "title": "",
        "content": "",
        "category": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "title": "",
          "content": "",
          "category": 0
        }
      '''
    }
  }
}
