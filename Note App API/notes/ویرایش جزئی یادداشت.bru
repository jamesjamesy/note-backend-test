meta {
  name: ویرایش جزئی یادداشت
  type: http
  seq: 6
  tags: [
    notes
  ]
}

patch {
  url: {{baseUrl}}/api/notes/update/:id
  body: json
  auth: apikey
}

params:path {
  id: 
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "title": "",
    "content": "",
    "category": 0
  }
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  ویرایش بخشی از اطلاعات یادداشت.
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/notes/update/:id
    method: PATCH
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "title": "",
        "content": "",
        "category": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "meta": {
            "message": "Operation successful",
            "errors": {}
          },
          "data": {
            "id": 0,
            "title": "",
            "content": "",
            "created_at": "",
            "updated_at": "",
            "category": ""
          }
        }
      '''
    }
  }
}
