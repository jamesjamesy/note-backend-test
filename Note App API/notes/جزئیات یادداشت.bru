meta {
  name: جزئیات یادداشت
  type: http
  seq: 3
  tags: [
    notes
  ]
}

get {
  url: {{baseUrl}}/api/notes/detail/:id
  body: none
  auth: apikey
}

params:path {
  id: 
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  دریافت اطلاعات کامل یک یادداشت بر اساس شناسه.
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/notes/detail/:id
    method: GET
    mode: none
    params:path: {
      id: 
    }
  
    headers: {
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "meta": {
            "message": "Operation successful",
            "errors": {}
          },
          "data": {
            "id": 0,
            "title": "",
            "content": "",
            "created_at": "",
            "updated_at": "",
            "category": ""
          }
        }
      '''
    }
  }
}
