meta {
  name: لیست یادداشت‌ها
  type: http
  seq: 4
  tags: [
    notes
  ]
}

get {
  url: {{baseUrl}}/api/notes/list
  body: none
  auth: apikey
}

params:query {
  @description('A page number within the paginated result set.')
  ~page: 
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  دریافت لیست یادداشت‌های کاربر یا یادداشت‌های عمومی به صورت صفحه‌بندی‌شده.
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/notes/list
    method: GET
    mode: none
    params:query: {
      ~page: 
    }
  
    headers: {
      Authorization: {{apiKey}}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "meta": {
            "message": "Operation successful",
            "errors": {}
          },
          "data": {
            "count": 123,
            "next": "http://api.example.org/accounts/?page=4",
            "previous": "http://api.example.org/accounts/?page=2",
            "results": [
              {
                "id": 0,
                "title": "",
                "content": "",
                "created_at": "",
                "updated_at": "",
                "category": ""
              }
            ]
          }
        }
      '''
    }
  }
}
