meta {
  name: notes_partial_update
  type: http
  seq: 5
  tags: [
    notes
  ]
}

patch {
  url: {{baseUrl}}/api/notes/:id/
  body: json
  auth: apikey
}

params:path {
  @description('A unique integer value identifying this note.')
  id: 
}

headers {
  @description('Token-based authentication with required prefix "Token"')
  Authorization: {{apiKey}}
}

auth:apikey {
  key: Authorization
  value: {{apiKey}}
  placement: header
}

body:json {
  {
    "title": "",
    "content": "",
    "category": 0
  }
}

settings {
  forwardAuthorizationHeader: false
}

example {
  name: 200 Response
  
  request: {
    url: {{baseUrl}}/api/notes/:id/
    method: PATCH
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      Authorization: {{apiKey}}
    }
  
    body:json: {
      {
        "title": "",
        "content": "",
        "category": 0
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "title": "",
          "content": "",
          "category": 0
        }
      '''
    }
  }
}
